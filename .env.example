# Niuma app environment variables
# Copy into .env.local for local development.
# Relative paths are resolved relative to the directory containing this file.

# Optional content roots
# Preferred: set the project root that contains .niuma/{agents,skills,commands}
NIUMA_CONTENT_DIR=.
NIUMA_ARTIFACT_DIR=./artifact

# Optional frontend-only vars
# VITE_ELEVENLABS_API_KEY=

# Optional backend/license vars
# PAYMENT_ENDPOINT=
# API_ACCESS_KEY=
# APP_ENDPOINT=
# POSTHOG_API_KEY=
