# Niuma 环境模板
# 复制为本目录的 .env.local 后填写（.env.local 已 gitignore，勿提交）。
#
# 开发：放在仓库根。微信/IMA 等运行时读取工作区 `.env.local`。
# 便携包：放在 Niuma.exe 与 .teams 同级。打包脚本会把本文件拷进 zip。
#
# 相对路径相对本文件所在目录解析。不要在本文件写真实密钥。
# NIUMA_CONTENT_DIR / NIUMA_ARTIFACT_DIR 不会打进二进制，避免便携版读到开发机路径。

# --- 工作区（可选） ----------------------------------------------------------
# 含 .teams 的根目录。便携版不要填：exe 旁有 .teams 时即以该目录为工作区。
# NIUMA_CONTENT_DIR=.
# 稿件/截图等。未填时用 <工作区>/.artifacts
# NIUMA_ARTIFACT_DIR=./.artifacts
# 也可写 NIUMA_HOME / NIUMA_ROOT_DIR（与 NIUMA_CONTENT_DIR 同义）
# NIUMA_ROOT_DIR=

# --- IMA 文章资产（运行时读工作区 .env.local） --------------------------------
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
# 别名也可：IMA_CLIENT_ID / IMA_API_KEY

# --- 本地模型密钥（也可在应用设置里填） --------------------------------------
STT_API_KEY=
AGNES_API_KEY=

# --- WebView 设置（与 .teams 同级） ------------------------------------------
# 首次启动在 `.niumaconfig/setting.json` 生成缺省（界面中文、STT 中文等）。
# 修改设置后会自动写回该文件（约 0.6s 防抖）；退出时也会再保存一次。
# 稿件正文在 `.artifacts/drafts/`，不会写入 setting.json / localStorage。
# 复制工作区目录即可带走 UI/Provider 等配置（勿提交含密钥的 setting.json）。

# --- 微信公众号槽位（/publish WECHAT，运行时读 .env.local） --------------------
WECHAT_1_APPID=
WECHAT_1_APPSECRET=
# WECHAT_1_NAME=主号
# WECHAT_1_API_BASE=
# 多账号递增 WECHAT_2_APPID / WECHAT_2_APPSECRET …
