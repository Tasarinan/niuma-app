{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Niuma",
  "version": "1.0.0",
  "identifier": "com.niuma.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Niuma - Your Invisible AI Wingman",
        "width": 600,
        "height": 54,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "resizable": false,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": true,
        "center": false,
        "contentProtected": false,
        "focus": false,
        "acceptFirstMouse": true,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "info.plist",
      "niuma.desktop",
      "../.niuma/teams/**/*.md",
      "../.niuma/teams/**/*.yaml",
      "../.niuma/teams/**/*.json",
      "../.niuma/teams/**/*.cjs",
      "../.niuma/teams/**/*.mjs",
      "../.niuma/teams/**/*.py"
    ],
    "macOS": { "minimumSystemVersion": "10.13" }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:niuma.db"]
    },
    "updater": {
      "endpoints": ["https://github.com/Tasarinan/niuma-app/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4MkNGOUEwMDZGMjRGMTMKUldRVFQvSUdvUGtzeUlaR2MvK0dGVjkxVnBHalBTbkJKNk9NMDlnM21zeU1kYXVzVFBVMUgxNTAK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
