# Build-time env for the Tauri backend (src-tauri/build.rs).
#
# Prefer a single file at the repo root: copy ../.env.example → ../.env.local
# build.rs walks up from src-tauri and loads .env.local / .env.
# You only need a file here if you are building from src-tauri in isolation.

# POSTHOG_API_KEY=
# PAYMENT_ENDPOINT=
# API_ACCESS_KEY=
# APP_ENDPOINT=
# NIUMA_CONTENT_DIR=
# NIUMA_ARTIFACT_DIR=
