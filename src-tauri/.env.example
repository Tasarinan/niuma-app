# Build-time environment variables for Niuma's Tauri backend.
# Copy this file to .env.local or .env and fill in values before running `pnpm tauri dev` or `pnpm tauri build`.
# The env file is read by build.rs via the dotenv crate and the values are compiled into the binary.

# PostHog analytics API key — leave empty to disable analytics (no-op, events are silently dropped)
POSTHOG_API_KEY=

# Backend endpoints (optional — only required for production / license-gated features)
PAYMENT_ENDPOINT=
API_ACCESS_KEY=
APP_ENDPOINT=

# Optional content roots.
# Relative paths are resolved relative to the directory containing this .env file.
# Example when .env is at the repo root:
# NIUMA_ARTIFACT_DIR=./artifact
# NIUMA_CLAWPACKS_DIR=./clawpacks
NIUMA_ARTIFACT_DIR=
NIUMA_CLAWPACKS_DIR=
