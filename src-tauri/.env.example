# Build-time environment variables for Niuma's Tauri backend.
# Copy this file to .env and fill in values before running `pnpm tauri dev` or `pnpm tauri build`.
# The .env file is read by build.rs via the dotenv crate and the values are compiled into the binary.

# PostHog analytics API key — leave empty to disable analytics (no-op, events are silently dropped)
POSTHOG_API_KEY=

# Backend endpoints (optional — only required for production / license-gated features)
PAYMENT_ENDPOINT=
API_ACCESS_KEY=
APP_ENDPOINT=
